# ============================================================
#  NIAJI — WhatsApp Bot configuration
#  Copy this file to `.env` and fill in your values.
#  NEVER commit `.env` to git.
# ============================================================

# --- AI provider (pick ONE) ------------------------------------
# "openai", "anthropic", "gemini", or "groq"
#   groq  = FREE (no credit card) — key from console.groq.com
#   gemini = FREE tier — key from aistudio.google.com/apikey
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Free Gemini key from https://aistudio.google.com/apikey (no billing needed)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Voice replies (voice note in -> voice note out) --------------
# Set to true to reply to voice notes with a voice note (requires TTS + ffmpeg).
# Voice notes are ALWAYS transcribed and replied to as text as the base feature.
VOICE_AUTO_REPLY=false
# TTS provider: "openai" (default, uses OPENAI_API_KEY) or "elevenlabs" (uses ELEVENLABS_API_KEY)
TTS_PROVIDER=openai
TTS_VOICE=alloy
# ElevenLabs (only if TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# --- Style learning -------------------------------------------------
# How many of your own real WhatsApp messages to feed the AI as a few-shot
# style guide (set to 0 to disable style injection). The bot automatically
# collects your outgoing texts as style samples.
STYLE_SAMPLE_COUNT=30

# --- Dashboard settings ---------------------------------------------
# Login for the web dashboard (Overview / Chats / Devices & Logins / Training / Settings)
DASH_PASSWORD=change-me-in-production
DASH_USER=admin
DASH_HOST=0.0.0.0

# Optional: pick specific models
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Voice notes (Whisper, needs an OPENAI key) ----------------
# Uses OPENAI_API_KEY above if WHISPER_API_KEY is empty.
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# --- Google web search (optional, free tier = 100 req/day) ------
# Create a Programmable Search Engine: https://programmablesearchengine.google.com
# • Name it anything, pick "Search the entire web"
# • Copy the "Search engine ID" -> GOOGLE_CX
# • Enable "Custom Search JSON API" and copy the API key -> GOOGLE_API_KEY
# If these are empty, the bot falls back to a keyless DuckDuckGo search.
GOOGLE_API_KEY=
GOOGLE_CX=

# --- Bot behaviour ----------------------------------------------
BOT_NAME=Niaji
# Reply to group messages? (recommended: false to avoid spam risk)
ALLOW_GROUPS=false
# Auto-reply on for brand-new chats (you can toggle per-chat with !auto off)
AUTO_REPLY_DEFAULT=true
# Automatically "like" (react to) statuses after viewing them (dashboard toggle)
STATUS_REACTS=true
# Min gap in ms between auto-replies in the SAME chat (anti-spam / human-like)
MIN_REPLY_SPACING_MS=8000
# Upper bound for the human-like "typing" delay in ms
MAX_REPLY_DELAY_MS=7000

# --- Owner ------------------------------------------------
# Your WhatsApp id like 254712345678@s.whatsapp.net
# Leave empty to auto-detect (it's the account you scan QR with).
OWNER_JID=
# Your number WITHOUT the leading + (used for the small pairing-code login:
# Settings → Linked devices → "Link with phone number"). Optional — falls back to QR.
OWNER_PHONE=

# --- Render / hosting -------------------------------------------
# Public URL of your render service, WITHOUT trailing slash.
# The bot pings it every 30s so a free instance never sleeps.
KEEPALIVE_URL=
KEEPALIVE_TOKEN=

# HTTP port (Render sets this automatically as PORT)
PORT=3000